// Example schema. Also used by the test suite.
// Run `npm run build` first, then `npm run example:generate`.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator lean {
  provider = "node ../dist/bin.js"
  output   = "./generated/lean-client"
}

enum Role {
  USER
  ADMIN @map("admin")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile   Profile?
  orders    Order[]

  @@map("users")
}

model Profile {
  id       String  @id @default(uuid())
  bio      String? @db.Text
  settings Json?
  avatar   Bytes?
  userId   Int     @unique @map("user_id")
  user     User    @relation(fields: [userId], references: [id])
}

// `Order` is a reserved word in MySQL: identifiers must be quoted.
model Order {
  id     BigInt  @id @default(autoincrement())
  ref    String  @default(cuid())
  total  Decimal @db.Decimal(10, 2)
  userId Int
  user   User    @relation(fields: [userId], references: [id])
}

// Composite primary key.
model Membership {
  groupId Int
  userId  Int
  role    Role

  @@id([groupId, userId])
}

// No @id, only a @unique field. `Key` is also a reserved word.
model Key {
  name  String @unique
  value String
}
